<Page x:Class="UVVFintech_Grupo3.Views.SelecionarClienteView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Selecionar Cliente">

    <Grid Background="#0F172A">
        <StackPanel Margin="30">
            <TextBlock Text="Selecionar Cliente" Foreground="White" FontSize="20" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="CPF:" Width="60" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCpfFiltro" Width="200"/>
                <Button Content="Buscar" Width="100" Margin="10,0,0,0" Click="BtnBuscar_Click"/>
            </StackPanel>

            <ListView x:Name="lvClientes" Margin="0,20,0,0" Height="250">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Nome}" Width="200"/>
                        <GridViewColumn Header="CPF" DisplayMemberBinding="{Binding Cpf}" Width="120"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Selecionar" Width="120" Margin="5" Click="BtnSelecionar_Click"/>
                <Button Content="Cancelar" Width="120" Margin="5" Click="BtnCancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</Page>
