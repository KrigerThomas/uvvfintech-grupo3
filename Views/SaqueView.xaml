<Page x:Class="UVVFintech_Grupo3.Views.SaqueView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Saque">

    <Grid Background="#0F172A">
        <StackPanel Margin="30">
            <TextBlock Text="Sacar" Foreground="White" FontSize="20" Margin="0,0,0,20"/>

            <!-- Substitua PlaceholderText por um TextBlock acima do TextBox -->
            <TextBlock Text="Número da conta" Foreground="White" Margin="0,5,0,0"/>
            <TextBox x:Name="txtConta" Margin="0,5"/>

            <TextBlock Text="Valor" Foreground="White" Margin="0,5,0,0"/>
            <TextBox x:Name="txtValor" Margin="0,5"/>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button Content="Confirmar" Width="120" Margin="5" Click="BtnConfirmar_Click"/>
                <Button Content="Voltar" Width="120" Margin="5" Click="BtnVoltar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
