<Page x:Class="UVVFintech_Grupo3.Views.DepositoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Depósito">

    <Grid Background="#0F172A">
        <StackPanel Margin="30">
            <TextBlock Text="Depositar" Foreground="White" FontSize="20" Margin="0,0,0,20"/>

            <TextBox x:Name="txtConta" Margin="0,5">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="Gray"/>
                        <Setter Property="Text" Value="Número da conta"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Text" Value=""/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBox x:Name="txtValor" Margin="0,5">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="Gray"/>
                        <Setter Property="Text" Value="Valor"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Text" Value=""/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button Content="Confirmar" Width="120" Margin="5" Click="BtnConfirmar_Click"/>
                <Button Content="Voltar" Width="120" Margin="5" Click="BtnVoltar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
