<Page x:Class="UVVFintech_Grupo3.Views.ClientesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Clientes">

    <Grid Background="#0F172A">
        <StackPanel Margin="30">
            <TextBlock Text="Gerenciar Clientes" Foreground="White" FontSize="20" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Nome:" Width="60" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNome" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="CPF:" Width="60" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCpf" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Content="Cadastrar" Width="100" Margin="5" Click="BtnCadastrar_Click"/>
                <Button Content="Buscar" Width="100" Margin="5" Click="BtnBuscar_Click"/>
                <Button Content="Excluir" Width="100" Margin="5" Click="BtnExcluir_Click"/>
                <Button Content="Voltar" Width="100" Margin="5" Click="BtnVoltar_Click"/>
            </StackPanel>

            <ListView x:Name="lvClientes" Margin="0,20,0,0" Height="200"/>
        </StackPanel>
    </Grid>
</Page>
