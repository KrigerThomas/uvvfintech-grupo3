<Page x:Class="UVVFintech_Grupo3.Views.ClientesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Clientes"
      Background="#0F172A">

    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Top">
            
            <TextBlock Text="Gerenciar Clientes" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="Nome:" Width="70" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNome" Width="260" Background="#1E293B" Foreground="White" BorderThickness="0" Padding="6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8">
                <TextBlock Text="CPF:" Width="70" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCpf" Width="260" Background="#1E293B" Foreground="White" BorderThickness="0" Padding="6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12">
                <Button Content="Cadastrar" Width="110" Margin="6" Background="#3B82F6" Foreground="White" Click="BtnCadastrar_Click"/>
                <Button Content="Buscar" Width="110" Margin="6" Background="#1E40AF" Foreground="White" Click="BtnBuscar_Click"/>
                <Button Content="Excluir" Width="110" Margin="6" Background="#DC2626" Foreground="White" Click="BtnExcluir_Click"/>
                <Button Content="Voltar" Width="110" Margin="6" Background="#334155" Foreground="White" Click="BtnVoltar_Click"/>
            </StackPanel>

            <Border CornerRadius="6" BorderBrush="#273444" BorderThickness="1" Margin="0,14,0,0">
                <ListView x:Name="lvClientes" Height="260" Background="#0F172A" Foreground="White" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                            <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Nome}" Width="320"/>
                            <GridViewColumn Header="CPF" DisplayMemberBinding="{Binding Cpf}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </StackPanel>
    </Grid>
</Page>
