<Page x:Class="UVVFintech_Grupo3.Views.ContasView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Contas"
      Background="#0F172A">

    <Grid>
        <StackPanel Margin="30">
            <TextBlock Text="Gerenciar Contas" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="CPF Cliente:" Width="100" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCpfCliente" Width="220" Background="#1E293B" Foreground="White" BorderThickness="0" Padding="6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8">
                <TextBlock Text="Tipo Conta:" Width="100" Foreground="White" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbTipoConta"
                          Width="220" Foreground="#FF1E293B">
                    <ComboBoxItem Content="Corrente"/>
                    <ComboBoxItem Content="Poupança"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12">
                <Button Content="Criar" Width="110" Margin="6" Background="#3B82F6" Foreground="White" Click="BtnCriar_Click"/>
                <Button Content="Buscar" Width="110" Margin="6" Background="#1E40AF" Foreground="White" Click="BtnBuscar_Click"/>
                <Button Content="Excluir" Width="110" Margin="6" Background="#DC2626" Foreground="White" Click="BtnExcluir_Click"/>
                <Button Content="Voltar" Width="110" Margin="6" Background="#334155" Foreground="White" Click="BtnVoltar_Click"/>
            </StackPanel>

            <Border CornerRadius="6" BorderBrush="#273444" BorderThickness="1" Margin="0,14,0,0">
                <ListView x:Name="lvContas" Height="260" Background="#0F172A" Foreground="White" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="60"/>
                            <GridViewColumn Header="Número" DisplayMemberBinding="{Binding Numero}" Width="140"/>
                            <GridViewColumn Header="Saldo" DisplayMemberBinding="{Binding Saldo}" Width="110"/>
                            <GridViewColumn Header="ClienteId" DisplayMemberBinding="{Binding ClienteId}" Width="100"/>
                            <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding TipoConta}" Width="100"/>
                            <GridViewColumn Header="Limite" DisplayMemberBinding="{Binding Limite}" Width="110"/>
                            <GridViewColumn Header="TaxaRend." DisplayMemberBinding="{Binding TaxaRendimento}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </StackPanel>
    </Grid>
</Page>
