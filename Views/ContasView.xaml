<Page x:Class="UVVFintech_Grupo3.Views.ContasView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Contas">

    <Grid Background="#0F172A">
        <StackPanel Margin="30">
            <TextBlock Text="Gerenciar Contas" Foreground="White" FontSize="20" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="CPF Cliente:" Width="100" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCpfCliente" Width="180"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Tipo Conta:" Width="100" Foreground="White" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbTipoConta" Width="180">
                    <ComboBoxItem Content="Corrente"/>
                    <ComboBoxItem Content="Poupança"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Content="Criar" Width="100" Margin="5" Click="BtnCriar_Click"/>
                <Button Content="Buscar" Width="100" Margin="5" Click="BtnBuscar_Click"/>
                <Button Content="Excluir" Width="100" Margin="5" Click="BtnExcluir_Click"/>
                <Button Content="Voltar" Width="100" Margin="5" Click="BtnVoltar_Click"/>
            </StackPanel>

            <ListView x:Name="lvContas" Margin="0,20,0,0" Height="200"/>
        </StackPanel>
    </Grid>
</Page>
