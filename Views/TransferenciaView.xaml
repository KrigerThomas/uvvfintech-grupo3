<Page x:Class="UVVFintech_Grupo3.Views.TransferenciaView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Transferência"
      Background="#0F172A">

    <Grid>
        <Border CornerRadius="12"
                Background="#142033"
                Padding="22"
                Width="520"
                Height="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Transferência"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,14"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Conta de origem:" Foreground="White" Margin="0,6,0,2"/>
                <TextBox x:Name="txtOrigem"
                         IsReadOnly="True"
                         Height="32"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#273444"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Selecionar conta destino"
                            Width="200"
                            Background="#3B82F6"
                            Click="BtnSelecionarDestino_Click"/>
                    <TextBox x:Name="txtDestino"
                             IsReadOnly="True"
                             Height="32"
                             Margin="10,0,0,0"
                             Background="#0F172A"
                             Foreground="White"
                             BorderBrush="#273444"
                             Width="260"/>
                </StackPanel>

                <TextBlock Text="Valor" Foreground="White" Margin="0,12,0,2"/>
                <TextBox x:Name="txtValor" Height="32" Background="#0F172A" Foreground="White" BorderBrush="#273444"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Confirmar" Width="140" Click="BtnConfirmar_Click"/>
                    <Button Content="Cancelar" Width="140" Background="#334155" Click="BtnCancelar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
