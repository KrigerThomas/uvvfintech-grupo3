<Page x:Class="UVVFintech_Grupo3.Views.SelecionarContaView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Selecionar Conta"
      Background="#0F172A">

    <Grid>
        <Border CornerRadius="12"
                Background="#1E293B"
                Padding="28"
                Width="520"
                Height="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Selecionar Conta"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <!-- CAMPO CPF -->
                <TextBlock Text="Buscar por CPF:"
                           Foreground="White" Margin="0,4,0,2"/>
                <TextBox x:Name="txtCpf"
                         Height="32"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#273444"
                         Margin="0,0,0,10"/>

                <Button Content="Buscar"
                        Width="120"
                        HorizontalAlignment="Left"
                        Background="#3B82F6"
                        Foreground="White"
                        Click="BtnBuscar_Click"/>

                <!-- LISTA DE CONTAS -->
                <ListView x:Name="lvContas"
                          Height="260"
                          Margin="0,20,0,10"
                          Background="#0F172A"
                          Foreground="White"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Número" DisplayMemberBinding="{Binding Numero}" Width="120"/>
                            <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding TipoConta}" Width="100"/>
                            <GridViewColumn Header="Saldo" DisplayMemberBinding="{Binding Saldo}" Width="100"/>
                            <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding Cliente.Nome}" Width="150"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Selecionar"
                            Width="140"
                            Margin="5"
                            Background="#3B82F6"
                            Click="BtnSelecionar_Click"/>

                    <Button Content="Voltar"
                            Width="140"
                            Margin="5"
                            Background="#334155"
                            Click="BtnVoltar_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
