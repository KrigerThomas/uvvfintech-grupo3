<Page x:Class="UVVFintech_Grupo3.Views.TransacoesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Transações">

    <Grid Background="#0F172A">
        <StackPanel Margin="30">
            <TextBlock Text="Operações Bancárias" Foreground="White" FontSize="20" Margin="0,0,0,20"/>

            <Button Content="Sacar" Width="200" Height="40" Margin="0,5"
                    Background="#3B82F6" Foreground="White" Click="BtnSacar_Click"/>

            <Button Content="Depositar" Width="200" Height="40" Margin="0,5"
                    Background="#3B82F6" Foreground="White" Click="BtnDepositar_Click"/>

            <Button Content="Transferir" Width="200" Height="40" Margin="0,5"
                    Background="#3B82F6" Foreground="White" Click="BtnTransferir_Click"/>

            <Button Content="Voltar" Width="200" Height="40" Margin="20" 
                    Background="#64748B" Foreground="White" Click="BtnVoltar_Click"/>
        </StackPanel>
    </Grid>
</Page>
