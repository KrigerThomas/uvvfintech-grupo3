<Page x:Class="UVVFintech_Grupo3.Views.TransacoesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F172A"
      Title="Transações">

    <Grid>

        <Border Background="#1E293B"
                CornerRadius="12"
                Padding="30"
                Width="520"
                Height="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Transações"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- SELEÇÃO DE CONTA -->
                <TextBlock Text="Conta Selecionada:"
                           Foreground="White"
                           Margin="0,4,0,2"/>

                <TextBox x:Name="txtContaSelecionada"
                         IsReadOnly="True"
                         Height="32"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#273444"
                         Margin="0,0,0,10"
                         Text="Nenhuma conta selecionada."/>

                <Button Content="Selecionar Conta"
                        Height="34"
                        Width="160"
                        Background="#3B82F6"
                        Foreground="White"
                        Click="BtnSelecionarConta_Click"
                        HorizontalAlignment="Left"/>

                <Separator Margin="0,20,0,20" Background="Gray" Height="1"/>

                <!-- VALOR -->
                <TextBlock Text="Valor:"
                           Foreground="White"
                           Margin="0,4,0,2"/>
                <TextBox x:Name="txtValor"
                         Height="32"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#273444"
                         Margin="0,0,0,10"/>

                <!-- BOTÕES DE AÇÕES -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Content="Depositar"
                            Width="120"
                            Margin="6"
                            Background="#3B82F6"
                            Click="BtnDepositar_Click"/>

                    <Button Content="Sacar"
                            Width="120"
                            Margin="6"
                            Background="#1E40AF"
                            Click="BtnSacar_Click"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Transferir"
                            Width="120"
                            Margin="6"
                            Background="#9333EA"
                            Click="BtnTransferir_Click"/>

                    <Button Content="Extrato"
                            Width="120"
                            Margin="6"
                            Background="#475569"
                            Click="BtnExtrato_Click"/>

                </StackPanel>

                <Button Content="Voltar"
                        Width="140"
                        Margin="10"
                        Background="#334155"
                        Click="BtnVoltar_Click"
                        HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>

    </Grid>
</Page>
