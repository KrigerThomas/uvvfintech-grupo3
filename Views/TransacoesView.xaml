<Page x:Class="UVVFintech_Grupo3.Views.TransacoesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F172A"
      Title="Transações">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="350">

            <TextBlock Text="Transações"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,25"
                       HorizontalAlignment="Center"/>

            <Button Content="Saque"
                    Height="45"
                    Click="BtnSacar_Click"/>

            <Button Content="Depósito"
                    Height="45"
                    Click="BtnDepositar_Click"/>

            <Button Content="Transferência"
                    Height="45"
                    Click="BtnTransferir_Click"/>

            <Button Content="Voltar"
                    Height="45"
                    Background="#334155"
                    Margin="0,20,0,0"
                    Click="BtnVoltar_Click"/>

        </StackPanel>
    </Grid>
</Page>
